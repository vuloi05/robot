<?xml version="1.0"?>
<sdf version="1.9">
  <world name="restaurant_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <scene>
      <ambient>0.65 0.65 0.65 1.0</ambient>
      <background>0.85 0.90 0.95 1.0</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <light type="point" name="dock_light">
      <pose>-5.8 -3.6 2.2 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>8</range>
        <constant>0.5</constant>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <!-- =================================================================== -->
    <!-- Sàn nhà hàng (16m x 12m)                                            -->
    <!-- =================================================================== -->
    <model name="ground_floor">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>16 12</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>16 12</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.76 0.74 0.70 1</ambient>
            <diffuse>0.82 0.80 0.76 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- Tường bao nhà hàng 14m x 10m (x in [-7,7], y in [-5,5], cao 2.4m)   -->
    <!-- =================================================================== -->
    <model name="restaurant_walls">
      <static>true</static>
      <link name="walls_link">
        <!-- Tường Bắc (y = +5.0) -->
        <collision name="wall_north_col">
          <pose>0 5.0 1.2 0 0 0</pose>
          <geometry><box><size>14.2 0.2 2.4</size></box></geometry>
        </collision>
        <visual name="wall_north_vis">
          <pose>0 5.0 1.2 0 0 0</pose>
          <geometry><box><size>14.2 0.2 2.4</size></box></geometry>
          <material><ambient>0.65 0.63 0.58 1</ambient><diffuse>0.75 0.73 0.68 1</diffuse></material>
        </visual>

        <!-- Tường Nam (y = -5.0) -->
        <collision name="wall_south_col">
          <pose>0 -5.0 1.2 0 0 0</pose>
          <geometry><box><size>14.2 0.2 2.4</size></box></geometry>
        </collision>
        <visual name="wall_south_vis">
          <pose>0 -5.0 1.2 0 0 0</pose>
          <geometry><box><size>14.2 0.2 2.4</size></box></geometry>
          <material><ambient>0.65 0.63 0.58 1</ambient><diffuse>0.75 0.73 0.68 1</diffuse></material>
        </visual>

        <!-- Tường Tây (x = -7.0) -->
        <collision name="wall_west_col">
          <pose>-7.0 0 1.2 0 0 0</pose>
          <geometry><box><size>0.2 10.0 2.4</size></box></geometry>
        </collision>
        <visual name="wall_west_vis">
          <pose>-7.0 0 1.2 0 0 0</pose>
          <geometry><box><size>0.2 10.0 2.4</size></box></geometry>
          <material><ambient>0.65 0.63 0.58 1</ambient><diffuse>0.75 0.73 0.68 1</diffuse></material>
        </visual>

        <!-- Tường Đông (x = +7.0) -->
        <collision name="wall_east_col">
          <pose>7.0 0 1.2 0 0 0</pose>
          <geometry><box><size>0.2 10.0 2.4</size></box></geometry>
        </collision>
        <visual name="wall_east_vis">
          <pose>7.0 0 1.2 0 0 0</pose>
          <geometry><box><size>0.2 10.0 2.4</size></box></geometry>
          <material><ambient>0.65 0.63 0.58 1</ambient><diffuse>0.75 0.73 0.68 1</diffuse></material>
        </visual>

        <!-- Vách ngăn Bếp (x = -3.4), chừa cửa bếp rộng 1.6m tại y in [1.4, 3.0] -->
        <collision name="kitchen_wall_top_col">
          <pose>-3.4 4.0 1.2 0 0 0</pose>
          <geometry><box><size>0.16 2.0 2.4</size></box></geometry>
        </collision>
        <visual name="kitchen_wall_top_vis">
          <pose>-3.4 4.0 1.2 0 0 0</pose>
          <geometry><box><size>0.16 2.0 2.4</size></box></geometry>
          <material><ambient>0.55 0.60 0.65 1</ambient><diffuse>0.65 0.70 0.75 1</diffuse></material>
        </visual>

        <collision name="kitchen_wall_mid_col">
          <pose>-3.4 0.5 1.2 0 0 0</pose>
          <geometry><box><size>0.16 1.8 2.4</size></box></geometry>
        </collision>
        <visual name="kitchen_wall_mid_vis">
          <pose>-3.4 0.5 1.2 0 0 0</pose>
          <geometry><box><size>0.16 1.8 2.4</size></box></geometry>
          <material><ambient>0.55 0.60 0.65 1</ambient><diffuse>0.65 0.70 0.75 1</diffuse></material>
        </visual>

        <collision name="kitchen_wall_south_col">
          <pose>-5.2 -0.4 1.2 0 0 0</pose>
          <geometry><box><size>3.6 0.16 2.4</size></box></geometry>
        </collision>
        <visual name="kitchen_wall_south_vis">
          <pose>-5.2 -0.4 1.2 0 0 0</pose>
          <geometry><box><size>3.6 0.16 2.4</size></box></geometry>
          <material><ambient>0.55 0.60 0.65 1</ambient><diffuse>0.65 0.70 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- Khu Bếp (Quầy nấu nóng - Keepout Zone) & Quầy Lễ Tân               -->
    <!-- =================================================================== -->
    <model name="kitchen_hot_counter">
      <static>true</static>
      <pose>-6.2 2.5 0.45 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.9 3.6 0.9</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.9 3.6 0.9</size></box></geometry>
          <material><ambient>0.45 0.48 0.52 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="reception_desk">
      <static>true</static>
      <pose>5.6 3.5 0.50 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.8 2.2 1.0</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.8 2.2 1.0</size></box></geometry>
          <material><ambient>0.42 0.28 0.18 1</ambient><diffuse>0.58 0.40 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- Trạm sạc AprilTag (tại góc Tây Nam, quay mặt +X)                    -->
    <!-- =================================================================== -->
    <include>
      <uri>model://apriltag_dock</uri>
      <name>dock_01</name>
      <pose>-6.70 -3.60 0 0 0 0</pose>
    </include>

    <!-- =================================================================== -->
    <!-- 6 Bàn Ăn (4 chân mảnh + mặt bàn cao 0.74m -> điểm mù LiDAR thực tế) -->
    <!-- =================================================================== -->
    <!-- table_01 (-1.2, 2.2) -->
    <model name="table_01">
      <static>true</static>
      <pose>-1.2 2.2 0 0 0 0</pose>
      <link name="link">
        <collision name="top_col"><pose>0 0 0.74 0 0 0</pose><geometry><box><size>1.0 0.8 0.04</size></box></geometry></collision>
        <visual name="top_vis"><pose>0 0 0.74 0 0 0</pose><geometry><box><size>1.0 0.8 0.04</size></box></geometry><material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.70 0.48 0.28 1</diffuse></material></visual>
        <collision name="leg1_col"><pose>0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg1_vis"><pose>0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="leg2_col"><pose>0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg2_vis"><pose>0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="leg3_col"><pose>-0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg3_vis"><pose>-0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="leg4_col"><pose>-0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg4_vis"><pose>-0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- table_02 (1.8, 2.2) -->
    <model name="table_02">
      <static>true</static>
      <pose>1.8 2.2 0 0 0 0</pose>
      <link name="link">
        <collision name="top_col"><pose>0 0 0.74 0 0 0</pose><geometry><box><size>1.0 0.8 0.04</size></box></geometry></collision>
        <visual name="top_vis"><pose>0 0 0.74 0 0 0</pose><geometry><box><size>1.0 0.8 0.04</size></box></geometry><material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.70 0.48 0.28 1</diffuse></material></visual>
        <collision name="leg1_col"><pose>0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg1_vis"><pose>0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="leg2_col"><pose>0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg2_vis"><pose>0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="leg3_col"><pose>-0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg3_vis"><pose>-0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="leg4_col"><pose>-0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg4_vis"><pose>-0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- table_03 (4.6, 0.2) -->
    <model name="table_03">
      <static>true</static>
      <pose>4.6 0.2 0 0 0 0</pose>
      <link name="link">
        <collision name="top_col"><pose>0 0 0.74 0 0 0</pose><geometry><box><size>1.0 0.8 0.04</size></box></geometry></collision>
        <visual name="top_vis"><pose>0 0 0.74 0 0 0</pose><geometry><box><size>1.0 0.8 0.04</size></box></geometry><material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.70 0.48 0.28 1</diffuse></material></visual>
        <collision name="leg1_col"><pose>0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg1_vis"><pose>0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="leg2_col"><pose>0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg2_vis"><pose>0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="leg3_col"><pose>-0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg3_vis"><pose>-0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="leg4_col"><pose>-0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg4_vis"><pose>-0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- table_04 (-1.2, -2.2) -->
    <model name="table_04">
      <static>true</static>
      <pose>-1.2 -2.2 0 0 0 0</pose>
      <link name="link">
        <collision name="top_col"><pose>0 0 0.74 0 0 0</pose><geometry><box><size>1.0 0.8 0.04</size></box></geometry></collision>
        <visual name="top_vis"><pose>0 0 0.74 0 0 0</pose><geometry><box><size>1.0 0.8 0.04</size></box></geometry><material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.70 0.48 0.28 1</diffuse></material></visual>
        <collision name="leg1_col"><pose>0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg1_vis"><pose>0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="leg2_col"><pose>0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg2_vis"><pose>0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="leg3_col"><pose>-0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg3_vis"><pose>-0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="leg4_col"><pose>-0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg4_vis"><pose>-0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- table_05 (1.8, -2.2) -->
    <model name="table_05">
      <static>true</static>
      <pose>1.8 -2.2 0 0 0 0</pose>
      <link name="link">
        <collision name="top_col"><pose>0 0 0.74 0 0 0</pose><geometry><box><size>1.0 0.8 0.04</size></box></geometry></collision>
        <visual name="top_vis"><pose>0 0 0.74 0 0 0</pose><geometry><box><size>1.0 0.8 0.04</size></box></geometry><material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.70 0.48 0.28 1</diffuse></material></visual>
        <collision name="leg1_col"><pose>0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg1_vis"><pose>0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="leg2_col"><pose>0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg2_vis"><pose>0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="leg3_col"><pose>-0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg3_vis"><pose>-0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="leg4_col"><pose>-0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg4_vis"><pose>-0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- table_06 (4.6, -2.2) -->
    <model name="table_06">
      <static>true</static>
      <pose>4.6 -2.2 0 0 0 0</pose>
      <link name="link">
        <collision name="top_col"><pose>0 0 0.74 0 0 0</pose><geometry><box><size>1.0 0.8 0.04</size></box></geometry></collision>
        <visual name="top_vis"><pose>0 0 0.74 0 0 0</pose><geometry><box><size>1.0 0.8 0.04</size></box></geometry><material><ambient>0.55 0.35 0.20 1</ambient><diffuse>0.70 0.48 0.28 1</diffuse></material></visual>
        <collision name="leg1_col"><pose>0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg1_vis"><pose>0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="leg2_col"><pose>0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg2_vis"><pose>0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="leg3_col"><pose>-0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg3_vis"><pose>-0.42 0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
        <collision name="leg4_col"><pose>-0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry></collision>
        <visual name="leg4_vis"><pose>-0.42 -0.32 0.36 0 0 0</pose><geometry><box><size>0.06 0.06 0.72</size></box></geometry><material><ambient>0.2 0.2 0.2 1</ambient></material></visual>
      </link>
    </model>

    <!-- =================================================================== -->
    <!-- 2 Người Đi Bộ Động (có collision cho gpu_lidar & TrajectoryFollower)-->
    <!-- =================================================================== -->
    <model name="pedestrian_1">
      <pose>-2.2 0.0 0.85 0 0 0</pose>
      <link name="body_link">
        <inertial>
          <mass>20.0</mass>
          <inertia>
            <ixx>50.0</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>50.0</iyy><iyz>0</iyz>
            <izz>2.0</izz>
          </inertia>
        </inertial>
        <velocity_decay>
          <linear>2.0</linear>
          <angular>2.0</angular>
        </velocity_decay>
        <collision name="col">
          <geometry><cylinder><radius>0.22</radius><length>1.70</length></cylinder></geometry>
          <surface>
            <friction>
              <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="torso_vis">
          <geometry><cylinder><radius>0.22</radius><length>1.40</length></cylinder></geometry>
          <material><ambient>0.20 0.45 0.75 1</ambient><diffuse>0.25 0.55 0.85 1</diffuse></material>
        </visual>
        <visual name="head_vis">
          <pose>0 0 0.78 0 0 0</pose>
          <geometry><sphere><radius>0.14</radius></sphere></geometry>
          <material><ambient>0.88 0.72 0.58 1</ambient><diffuse>0.92 0.76 0.62 1</diffuse></material>
        </visual>
      </link>
      <plugin filename="gz-sim-trajectory-follower-system" name="gz::sim::systems::TrajectoryFollower">
        <link_name>body_link</link_name>
        <loop>true</loop>
        <force>20</force>
        <torque>15</torque>
        <range_tolerance>0.4</range_tolerance>
        <waypoints>
          <waypoint>-2.2 0.0</waypoint>
          <waypoint>2.4 0.0</waypoint>
        </waypoints>
      </plugin>
    </model>

    <model name="pedestrian_2">
