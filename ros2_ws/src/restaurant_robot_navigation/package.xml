<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>restaurant_robot_navigation</name>
  <version>0.1.0</version>
  <description>SLAM, EKF sensor fusion, AMCL, Nav2, Keepout/Speed zones, and opennav_docking configuration.</description>
  <maintainer email="dev@restaurant-robot.local">vuloi</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_localization</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>opennav_docking</exec_depend>
  <exec_depend>apriltag_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
