<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>restaurant_robot_bringup</name>
  <version>0.1.0</version>
  <description>Hardware bringup launch files, udev rules, and ros2_control configuration for the physical Raspberry Pi 5 robot.</description>
  <maintainer email="dev@restaurant-robot.local">vuloi</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>restaurant_robot_description</exec_depend>
  <exec_depend>ros2_control</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
