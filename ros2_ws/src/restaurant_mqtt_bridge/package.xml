<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>restaurant_mqtt_bridge</name>
  <version>0.1.0</version>
  <description>ROS 2 to Mosquitto MQTT bridge node implementing Contract v1 (QoS 1, LWT, cmd_ack idempotency).</description>
  <maintainer email="dev@restaurant-robot.local">vuloi</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>restaurant_robot_msgs</exec_depend>
  <exec_depend>python3-paho-mqtt</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
