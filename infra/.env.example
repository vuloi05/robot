# Cấu hình cho Rust Fleet Server (server/)
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info,restaurant_fleet_server=debug

# Kết nối MQTT Broker (Local LAN hoặc VPS)
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=restaurant_fleet_server
# MQTT_USERNAME=fleet_server
# MQTT_PASSWORD=change_me

# SQLite local (có thể đổi sang postgres://... trên VPS lớn)
DATABASE_URL=sqlite://restaurant.db?mode=rwc

# Cấu hình Frontend (web_app/)
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws
